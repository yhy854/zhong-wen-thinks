{
  "name": "zhong-wen-thinks",
  "version": "0.1.0",
  "type": "module",
  "description": "Force the agent chain-of-thought to stay in Simplified Chinese.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhy854/zhong-wen-thinks.git"
  },
